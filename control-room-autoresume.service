[Unit]
Description=Control Room: wake a dormant Claude session when the panel writes to it
After=control-room.service

[Service]
Type=simple
WorkingDirectory=/home/wii/Projects/certain/control-room
Environment=PATH=/home/wii/.local/bin:/home/wii/.local/node/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 autoresume.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
