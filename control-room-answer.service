[Unit]
Description=Control Room fallback answerer (headless Claude, only when no session is watching)
After=control-room.service

[Service]
Type=simple
WorkingDirectory=/home/wii/Projects/certain/control-room
Environment=ANSWER_GRACE=180
Environment=PATH=/home/wii/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 answer_agent.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
