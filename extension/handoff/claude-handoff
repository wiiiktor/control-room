#!/bin/sh
# Control Room's handoff wrapper -- set as the Claude extension's `claudeCode.claudeProcessWrapper`.
#
# The Claude extension runs:   claude-handoff <its bundled claude> <arguments...>
#
# ⛔ WHY IT EXISTS. When the Claude window opens a conversation that the room is running as a
# BACKGROUND session, `claude --resume <id>` refuses to start -- "Session <id> is running as a
# background session" -- and the window shows "Claude Code process exited with code 1" over a page
# of debug output. Nothing in the Claude extension handles it. A conversation can run in one place
# at a time, and opening it in the window is the reader choosing where: so before a resume, this
# releases the conversation from the room (`claude stop` touches background sessions only -- on
# anything else it answers "No job matching" and does nothing), and then the resume succeeds.
#
# Everything else passes through untouched. Whatever goes wrong in here, claude still starts.

real="$1"
[ -n "$real" ] || { echo "claude-handoff: no claude binary given" >&2; exit 127; }
shift

sid=""
want=""
for a in "$@"; do
  if [ -n "$want" ]; then
    want=""
    case "$a" in -*) ;; *) sid="$a" ;; esac
    continue
  fi
  case "$a" in
    --resume=*) sid="${a#--resume=}" ;;
    --resume|-r) want=1 ;;
  esac
done

case "$sid" in
  [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-*)
    short=$(printf '%s' "$sid" | cut -c1-8)
    if "$real" stop "$short" >/dev/null 2>&1; then
      state="${CONTROL_ROOM_STATE:-$HOME/.claude/control-room}"
      mkdir -p "$state" 2>/dev/null
      printf '%s released %s for the Claude window (cwd %s)\n' \
        "$(date '+%Y-%m-%dT%H:%M:%S')" "$sid" "$PWD" >> "$state/handoff.log" 2>/dev/null
      # Tell the room it lost its session, in the room itself. Best effort: no python, no notice.
      if command -v python3 >/dev/null 2>&1; then
        python3 - "$PWD" "$sid" >/dev/null 2>&1 <<'PY'
import glob, json, os, sys
cwd, sid = sys.argv[1], sys.argv[2]

def title():
    # the Claude window names a conversation by its aiTitle; read it from the transcript's tail
    for t in glob.glob(os.path.expanduser('~/.claude/projects/*/%s.jsonl' % sid)):
        try:
            with open(t, 'rb') as fh:
                fh.seek(0, 2); fh.seek(max(0, fh.tell() - 262144))
                tail = fh.read().decode('utf-8', 'replace').splitlines()
        except OSError:
            continue
        for line in reversed(tail):
            try:
                d = json.loads(line)
            except ValueError:
                continue
            if d.get('type') == 'ai-title' and d.get('aiTitle'):
                return d['aiTitle']
    return sid[:8]

for room in sorted(glob.glob(os.path.join(cwd, 'control-room*'))):
    bound = [os.path.join(room, n) for n in ('.watch.' + sid, '.session.' + sid)]
    if not any(os.path.exists(p) for p in bound) or not os.path.exists(os.path.join(room, 'chatlog.py')):
        continue
    for gone in ('.watch.' + sid, '.session.' + sid):  # the panel sees at once that it left, and the
        try:                                           # hooks no longer treat it as the room's session
            os.unlink(os.path.join(room, gone))
        except OSError:
            pass
    os.environ['CONTROL_ROOM_DIR'] = room
    sys.path.insert(0, room)
    import chatlog
    name = title()
    text = '\n'.join([
        '::warn ' + name + ' moved to the Claude window',
        '::say You opened this conversation in the Claude window, so the room let go of it: a '
        'conversation runs in one place at a time, and the window could not have opened it otherwise.',
        '::note Nothing is lost. Writing to it here brings it back, and closes it in the Claude window.',
    ])
    try:
        chatlog.append_message('assistant', text, about=sid)
    except TypeError:            # a room still holding a chatlog.py from before `about`
        chatlog.append_message('assistant', text)
    sys.path.pop(0)
    del sys.modules['chatlog']
PY
      fi
    fi
    ;;
esac

# Sessions the Claude window hosts are marked, so the room's session-start hook never tells them to
# watch a room: they cannot keep a watch, and a second watcher answers everything twice.
# ⛔ WITH THIS PROCESS'S PID. A background session does not get the environment of the command that
# started it -- it gets the long-lived daemon's (measured), and the daemon was started by whichever
# `claude --bg` came first, possibly one run from inside a Claude window. A bare marker could then
# end up on every room session. exec keeps the pid, so the hook trusts the marker only when this
# claude is its parent.
CONTROL_ROOM_HOST=claude-window
CONTROL_ROOM_HOST_PID=$$
export CONTROL_ROOM_HOST CONTROL_ROOM_HOST_PID
exec "$real" "$@"
